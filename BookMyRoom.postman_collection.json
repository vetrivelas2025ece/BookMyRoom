              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reports",
                "monthly"
              ],
              "query": [
                {
                  "key": "year",
                  "value": "2026"
                },
                {
                  "key": "month",
                  "value": "10"
                }
