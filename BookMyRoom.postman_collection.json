              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Complete booking (changes status)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/1/complete",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
